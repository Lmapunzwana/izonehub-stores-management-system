# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed to source control.

# PostgreSQL
POSTGRES_PASSWORD=change_me_strong_postgres_password

# Spring Boot datasource (same as POSTGRES_PASSWORD above)
SPRING_DATASOURCE_PASSWORD=change_me_strong_postgres_password

# JWT secret — generate with: openssl rand -hex 64
JWT_SECRET=change_me_generate_with_openssl_rand_hex_64

# Frontend base URL (used in password reset emails)
APP_BASE_URL=http://localhost:3000

# Email provider: logging (no-op/console), resend, ses
APP_EMAIL_PROVIDER=logging
RESEND_API_KEY=

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000
